\contentsline {figure}{\numberline {A.1}{\ignorespaces Dependency graph of \texttt {GetOperand}, which resolves a source operand to a DAG index by dispatching on operand type (register, memory, immediate).}}{51}{figure.A.1}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Dependency graph of \texttt {SetOperand}, which writes a DAG index to a destination operand, handling register aliasing and memory stores.}}{52}{figure.A.2}%
